---
import "../styles/styles.css";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ink</title>
    <meta
      name="description"
      content="A side-on runner where you draw the ground you land on, and the ink runs out."
    />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="./card.png" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <!--
      The h1 and nav are present for the invariants and for screen readers, and
      visually hidden because the brief forbids words on screen. A name is
      allowed; instructions are not. Nothing here may ever explain how to play.
    -->
    <header>
      <nav aria-label="Primary">
        <a href="./">Ink</a>
      </nav>
    </header>
    <main>
      <h1>Ink</h1>
      <canvas id="stage" role="application" aria-label="Ink"></canvas>
    </main>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
